# Never commit the database dump — it may contain personal data (see e2e/README.md).
# Keep this folder in git, ignore its contents.
*
!.gitignore
# Exceptions: the states seed is public reference data (federal state names and AVV
# id formats), not a dump, and the stack needs it — without it the AVV id format rule
# has an empty regex list and validates nothing. See seed-states.js.
!seed-states.js
!states.json
