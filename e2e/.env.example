# Copy to e2e/.env for local runs. NON-SECRET knobs only.
# Real secrets (if any) belong in GitHub Actions secrets, not here.

# Parse dev credentials (local config uses these literal values).
PARSE_APP_ID=appId
PARSE_MASTER_KEY=masterKey

# Parse endpoint used by the seeders (e2e/seed/seed-states.js, seed-users.js). Reachable
# on the host only with e2e/docker-compose.integration.yml in the compose file set.
PARSE_URL=http://localhost:1337/admin/parse

# The seed data itself is NOT configured here: it is a file at e2e/seed/seed-data.js.gz,
# built with `node e2e/seed/make-seed.js` and committed, so it arrives with a checkout.
# The repository secret E2E_SEED_URL overrides it with a download. See e2e/README.md.
